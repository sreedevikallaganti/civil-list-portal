# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── PocketBase (database) ─────────────────────────────────────────
# Address of the PocketBase server, e.g. http://<host>:<port>
NEXT_PUBLIC_POCKETBASE_URL=
# Optional: a different address for the Next.js server to use (defaults to the one above)
# POCKETBASE_URL=

# ── Google Calendar / Meet ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Initial refresh token (after deploy, an admin can click "Reconnect Google" instead)
GOOGLE_REFRESH_TOKEN=
# "primary" or a calendar's email-style id
GOOGLE_CALENDAR_ID=primary
# Must match an Authorized redirect URI in Google Cloud Console:
# http://<server-address>:3000/api/google/callback
GOOGLE_REDIRECT_URI=

# ── Invite emails (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail: use an App Password, not the account password
SMTP_PASS=
# Optional: "Name <address>" shown as the sender (defaults to SMTP_USER)
# SMTP_FROM=

# ── More "Send from" accounts (Calendar event + Meet link + invite emails) ──
# Numbered 2…9. After adding one: restart the app, then Settings → Google accounts → Connect.
SENDER_2_EMAIL=
SENDER_2_LABEL=
# Which account sends the invites (emails, calendar invitations, Meet link) — an email or "s2"
SENDER_DEFAULT=
# Save every meeting in all the accounts' Google calendars (the others are added as a guest)
CALENDAR_ALL_ACCOUNTS=true
# Gmail app password of that account (myaccount.google.com/apppasswords) — for invite emails
SENDER_2_SMTP_PASS=
# Optional — filled automatically by "Connect" (stored in .google-token-s2.json)
# SENDER_2_REFRESH_TOKEN=

# ── Zoom (optional — adds "Zoom" next to "Google Meet" in the meeting form) ──
# marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth. Scopes: meeting:write:meeting:admin,
# meeting:update:meeting:admin, meeting:delete:meeting:admin. Then activate the app.
ZOOM_ACCOUNT_ID=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...
# The Zoom user who hosts the meetings (default: the app's owner)
# ZOOM_USER_EMAIL=...

# ── Follow-up alerts for meeting creators (emails, every 5 min) ───
# A PocketBase login the server uses to read meetings: a superuser, or an app user of the organisation.
# Leave empty to turn the alerts off. Needs the text field owner_email on the meetings collection.
PB_ALERTS_EMAIL=...
PB_ALERTS_PASSWORD=...
# Optional: the app's address, for links in the emails
# APP_URL=http://<server-address>:3000

# ── App settings ──────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
# HRMS employee list for Employees → "Sync from HRMS" (this is the default)
# HRMS_EMPLOYEES_URL=https://hrms.brihaspathi.in/api/locationtracking/employees
# Departments users can be put in (Users page dropdown), comma-separated — default list in src/lib/departments.ts
# NEXT_PUBLIC_DEPARTMENTS=Administration,Executive,Finance & Accounts,Human Resources,IT / Software,Legal
# Home city key from src/lib/cities.ts — no "visit" suggestions here
# NEXT_PUBLIC_HOME_CITY=hyderabad
# Dev only: extra hosts allowed to open the dev server, comma-separated
# ALLOWED_DEV_ORIGINS=

# ── "Ask AI" assistant (Meetings page) ────────────────────────────
# Tried in this order; if one fails or its free quota runs out, the next answers.
# Fill in at least one — without any, the assistant stays hidden.
# AI_PROVIDERS=gemini,groq,openrouter,ollama
# Google Gemini — free key at https://aistudio.google.com/apikey
#   (check Google's terms: free-tier prompts may be used to improve their models)
GEMINI_API_KEY=
# Several models, comma-separated = tried in order (a busy model often has a free sibling)
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
# OpenRouter — one key for many models; key at https://openrouter.ai/keys
#   models ending in ":free" cost nothing (daily limits). The model must support tool calling —
#   free models come and go, so check https://openrouter.ai/models (filter: free + tools) if it errors.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Ollama — free, runs on your own server, data stays in your network (https://ollama.com)
#   install, then: ollama pull llama3.1:8b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# Claude (paid) — only used when "claude" is in AI_PROVIDERS
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
